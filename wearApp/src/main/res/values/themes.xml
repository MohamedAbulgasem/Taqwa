<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen (plan 5 Task 3): the launcher icon itself, a 48 dp disc on black, as
         Google's Wear app quality item WO-V15 asks (drawable/splash_icon). The icon is round, so
         the parent is Theme.SplashScreen, with no icon background colour, which is for an icon
         that is not. Wear OS 3 (API 30) has no system splash screen, so androidx.core's splash
         screen draws this there (WearMainActivity's installSplashScreen), and from API 31 the
         system draws it from the same attributes. Once the app's first frame is ready, the
         activity is in the theme it had before, the device's own. -->
    <style name="Theme.Taqwa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>
