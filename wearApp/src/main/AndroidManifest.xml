<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A watch app: it is offered to watches and to nothing else. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Watch Face Push's library asks for API 33 and works from API 36 alone; the app reaches Wear
         OS 3 (spec 2.1), and calls the library only where the system has it (AndroidFacePushPort). -->
    <uses-sdk tools:overrideLibrary="androidx.wear.watchfacepush" />

    <!-- Three permissions are declared, each with its line in wearApp/permissions.txt, the one list
         of them: VIBRATE, for the tasbeeh counter's ticks and the Qibla's buzz (app/WatchHaptics),
         and PUSH_WATCH_FACES and SET_PUSHED_WATCH_FACE_AS_ACTIVE, below. The ones that must never be here are the network's and the location
         ones (spec 2.1): the watch learns its times from the phone's feed alone, and the Qibla is
         turned true with the declination the feed carries, so the watch is never told where it
         is; the magnetometer needs no permission, so neither does BODY_SENSORS come. The feed comes
         from the phone through Google Play services' Wear Data Layer (link/), sent only while the
         two are directly connected, which can still at times cross Google's servers, end-to-end
         encrypted (Ruling 39). Play services joins with no permission: the merged manifest keeps
         these three and androidx.core's own alone (WearManifestTest holds this file to the list, and
         tools/wear-release-check.sh the merged manifest). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Watch Face Push (spec 3.1, plan 5 Tasks 4 and 5): the app installs and updates the Taqwa
         face in its one slot. Google's name, from "Watch Face Push: Wear OS app configuration". -->
    <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />

    <!-- And makes it the watch's face, once, on the wearer's tap (a runtime permission, asked on the
         face screen, FaceActivity). Google's name, from the same page. -->
    <uses-permission android:name="com.google.wear.permission.SET_PUSHED_WATCH_FACE_AS_ACTIVE" />

    <!-- allowBackup is off for the reason the phone's is: nothing of Taqwa's is copied off the
         watch to a backup. The feed names the person's city and the Qibla's bearing, and "Only
         your own devices can see your location" has to include the backup. data_extraction_rules.xml
         says the same in the form Android 12+ reads; below 12, allowBackup="false" alone is the
         whole answer, which is why lint's request for a fullBackupContent file as well is
         ignored, as the phone's is. -->
    <application
        android:name=".TaqwaWearApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:ignore="DataExtractionRules">

        <!-- The watch app needs the phone app: it has nothing to show until the phone has sent
             its feed, so it is not a standalone app (spec 2.1). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- The Taqwa face rides inside the app as Google's default watch face (the Lead's call 1):
             assets/default_watchface.apk, which the system installs into Taqwa's one slot when the
             app is installed, and never makes active. The system installs it only with the token
             Google's validator issued for that very APK, which FaceBundleTask (build.gradle.kts)
             makes at build time and writes as @string/default_wf_token: empty when no face is
             bundled, as on CI or in a release built without -Ptaqwa.faceApk. -->
        <meta-data
            android:name="com.google.android.wearable.marketplace.DEFAULT_WATCHFACE_VALIDATION_TOKEN"
            android:value="@string/default_wf_token" />

        <!-- Watch Face Push's library requires the system library wear-sdk, which only Wear OS 6 has
             (erratum p5): required, it would keep every earlier watch from installing the app, and
             Play would hide it from them. Not required, the system still gives it to the app where
             it is, and AndroidFacePushPort asks for it only there. -->
        <uses-library
            android:name="wear-sdk"
            android:required="false"
            tools:replace="android:required" />

        <!-- The face screen (plan 5 Task 5): adds the Taqwa face if it was removed, and makes it the
             watch's face once, on the wearer's tap. Today's chip opens it, and so does the phone's
             "Add the Taqwa face" row, through taqwa://face (RemoteActivityHelper), so it is exported;
             it does nothing a tap on the watch itself does not ask for. -->
        <activity
            android:name=".face.FaceActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="taqwa" android:host="face" />
            </intent-filter>
        </activity>

        <!-- After every update of the app (Google: a bundled face is not updated with the app), the
             face in Taqwa's slot is updated to the one this build carries. Only the system sends it. -->
        <receiver
            android:name=".face.FaceUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The app's screens: one activity, a pager of Today, Tasbeeh and Qibla (spec 2.5). An empty
             task affinity is Wear OS's rule for an activity, so that the app is one entry in the
             recents list however it was started. It is a single task, so that the Tile's tap
             brings the one there is forward (onNewIntent, on Today) rather than start a second,
             whose own tasbeeh counts the first could write over when it came back. It starts on
             the launch screen, the launcher icon itself on black (Theme.Taqwa.Starting), and is
             drawn in the device's own theme after it. -->
        <activity
            android:name=".app.WearMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Taqwa.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The complication sources (spec 2.3): what the Taqwa face's fixed slots show, and what
             any face can be given. Only the system can bind them (the permission), and it asks
             them for data. They list no SAFE_WATCH_FACES: a Watch Face Format face's fixed slots
             were given their data with no permission prompt in the spike, on that face and on
             Google's Utility face alike, so there is no face to name (if a prompt ever appears,
             the face's package is what the list would name: a Watch Face Format face has no
             service of its own).

             UPDATE_PERIOD_SECONDS is 21600 and not 0: the timelines the sources serve hold two
             days of prayers, so the system asks again a few times a day to keep them ahead, and
             the app also asks whenever a feed is stored (FeedStore). The period is only a wish:
             the system is not bound to keep it. -->
        <service
            android:name=".complication.NextPrayerSource"
            android:exported="true"
            android:icon="@drawable/ic_taqwa_arch"
            android:label="@string/complication_next_prayer"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="21600" />
        </service>

        <service
            android:name=".complication.DaySource"
            android:exported="true"
            android:icon="@drawable/ic_taqwa_arch"
            android:label="@string/complication_day"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="WEIGHTED_ELEMENTS" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="21600" />
        </service>

        <!-- The day dial's geometry, which the Taqwa face's Sun style reads in its fixed slot 7
             (DayDialSource). Its ranged value is packed numbers, a share that means nothing on any
             other face, so it is hidden from every picker; a face that names it as a slot's
             default is still given it. SAFE_WATCH_FACE_SUPPORTED_TYPES would be the other way,
             but the system honours it only for a source holding a signature and privileged
             permission, and without it the slot was given the battery. -->
        <service
            android:name=".complication.DayDialSource"
            android:exported="true"
            android:icon="@drawable/ic_taqwa_arch"
            android:label="@string/complication_day_dial"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.HIDDEN"
                android:value="true" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="21600" />
        </service>

        <service
            android:name=".complication.DatesSource"
            android:exported="true"
            android:icon="@drawable/ic_taqwa_arch"
            android:label="@string/complication_dates"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="21600" />
        </service>

        <!-- ICON is the manifest's name for a monochromatic image. -->
        <service
            android:name=".complication.MarkSource"
            android:exported="true"
            android:icon="@drawable/ic_taqwa_arch"
            android:label="@string/complication_mark"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="ICON" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="21600" />
        </service>

        <!-- The Tile (spec 2.4, plan 3 Task 8): the next start counted down, the day's six times
             (five where the phone hides Sunrise) and the city. Only the system can bind it (the
             permission). The picker shows its name, its description and its preview, the English
             Tile at 14:58 on the mock day, from the watch's own resources in the watch's language
             (spec 1.3). The preview is a shot of the round emulator, density-less. Lint asks for a
             square one beside it; the Tile draws the same on a square screen (its 200 units span
             the shorter side), so a square watch is shown this one, and no square shot is kept
             twice. -->
        <service
            android:name=".tile.TodayTileService"
            android:description="@string/tile_description"
            android:exported="true"
            android:icon="@drawable/ic_taqwa_arch"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview"
                tools:ignore="SquareAndRoundTilePreviews" />
        </service>

        <!-- The phone's feed and the phone coming back (plan 2 Task 6): the feed on
             /taqwa/feed/<origin>/<seq>/<fingerprint>, and taqwa_phone changing as the phone comes
             back nearby. Exported because Google Play services binds to it, and only Play services
             can: the library checks its caller. The feed's filter is a path prefix, since the
             delivery rides after it (FeedReceiver refuses anything else the prefix matches, such as
             /taqwa/feedback); the capability's is one literal path. LinkManifestTest holds both,
             and res/values/wear.xml's capability, to WatchLinkContract's. -->
        <service
            android:name=".link.FeedListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/taqwa/feed" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" android:path="/taqwa_phone" />
            </intent-filter>
        </service>

        <!-- The daily nudge (Ruling 22's safety net, and the daily handshake): reached only by the
             app's own inexact alarm (DailyNudge.arm), so it is not exported and has no filter. -->
        <receiver
            android:name=".link.DailyNudgeReceiver"
            android:exported="false" />
    </application>
</manifest>
