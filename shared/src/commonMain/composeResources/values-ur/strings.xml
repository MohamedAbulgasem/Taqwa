    <!-- Onboarding -->
    <string name="onboarding_welcome_title">تقویٰ</string>
    <string name="onboarding_welcome_body">نماز کے اوقات، قبلہ اور قرآن۔ ہمیشہ کے لیے مفت۔ نہ اشتہار، نہ اکاؤنٹ، اور آف لائن بھی چلتا ہے۔</string>
    <string name="onboarding_welcome_cta">شروع کریں</string>
    <string name="onboarding_location_title">آپ کہاں ہیں؟</string>
    <string name="onboarding_location_body">نماز کے اوقات آپ کے ٹھیک مقام پر منحصر ہیں۔ سارا حساب آپ کے فون پر ہوتا ہے، اور آپ کا مقام کبھی فون سے باہر نہیں جاتا۔</string>
    <string name="onboarding_location_cta">میرا مقام استعمال کریں</string>
    <string name="onboarding_location_secondary">اس کے بجائے شہر چنیں</string>
    <string name="onboarding_notifications_title">کوئی نماز نہ چھوٹے</string>
    <string name="onboarding_notifications_body">ہر نماز کے وقت ایک اطلاع۔ ہر نماز کی آواز آپ الگ الگ چن سکتے ہیں، اور جب چاہیں بدل سکتے ہیں۔</string>
    <string name="onboarding_notifications_cta">اطلاعات فعال کریں</string>
    <string name="onboarding_notifications_secondary">ابھی نہیں</string>
    <string name="onboarding_exact_title">عین وقت پر، منٹ کی پابندی سے</string>
    <string name="onboarding_exact_body">اینڈرائیڈ عین نماز کے وقت پر تبھی بجتا ہے جب تقویٰ کو ”الارم اور یاد دہانیاں“ کی اجازت ہو۔ اس کے بغیر اطلاع ایک گھنٹے تک دیر سے آ سکتی ہے۔</string>
    <string name="onboarding_widget_title">آپ کی ہوم اسکرین پر</string>
    <string name="onboarding_widget_body">تقویٰ کا ویجٹ ایپ کھولے بغیر اگلی نماز اور چلتی ہوئی الٹی گنتی دکھاتا ہے۔</string>
    <string name="onboarding_widget_body_ios">تقویٰ کا ویجٹ ایپ کھولے بغیر اگلی نماز اور چلتی ہوئی الٹی گنتی دکھاتا ہے۔ اسے شامل کرنے کے لیے ہوم اسکرین پر تقویٰ کے آئیکن کو دبا کر رکھیں اور ویجٹ کا سائز چنیں۔</string>
    <string name="onboarding_widget_body_ios_legacy">تقویٰ کا ویجٹ ایپ کھولے بغیر اگلی نماز اور چلتی ہوئی الٹی گنتی دکھاتا ہے۔ اسے شامل کرنے کے لیے ہوم اسکرین کو دبا کر رکھیں، اوپر کونے میں جمع کے نشان پر ٹیپ کریں، پھر تقویٰ تلاش کریں۔</string>
