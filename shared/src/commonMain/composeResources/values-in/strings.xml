    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Taqwa</string>
    <string name="onboarding_welcome_body">Waktu salat, kiblat, dan Al-Qur’an. Gratis selamanya. Tanpa iklan, tanpa akun, berfungsi offline.</string>
    <string name="onboarding_welcome_cta">Mulai</string>
    <string name="onboarding_location_title">Di mana Anda berada?</string>
    <string name="onboarding_location_body">Waktu salat bergantung pada posisi Anda yang tepat. Semuanya dihitung di perangkat Anda. Lokasi Anda tidak pernah keluar dari ponsel.</string>
    <string name="onboarding_location_cta">Gunakan lokasi saya</string>
    <string name="onboarding_location_secondary">Pilih kota saja</string>
    <string name="onboarding_notifications_title">Jangan lewatkan satu salat pun</string>
    <string name="onboarding_notifications_body">Notifikasi pada setiap waktu salat. Anda memilih suaranya untuk tiap salat secara terpisah, dan bisa menggantinya kapan saja.</string>
    <string name="onboarding_notifications_cta">Aktifkan notifikasi</string>
    <string name="onboarding_notifications_secondary">Nanti saja</string>
    <string name="onboarding_exact_title">Tepat pada waktunya</string>
    <string name="onboarding_exact_body">Android hanya berbunyi tepat pada waktu salat jika izin “Alarm &amp; pengingat” diberikan untuk Taqwa. Tanpa izin itu, notifikasi bisa terlambat sampai satu jam.</string>
    <string name="onboarding_widget_title">Di layar utama Anda</string>
    <string name="onboarding_widget_body">Widget Taqwa menampilkan salat berikutnya dan hitung mundur yang terus berjalan, tanpa membuka aplikasi.</string>
    <string name="onboarding_widget_body_ios">Widget Taqwa menampilkan salat berikutnya dan hitung mundur yang terus berjalan, tanpa membuka aplikasi. Untuk menambahkannya, sentuh dan tahan ikon Taqwa di layar utama, lalu pilih ukuran widget.</string>
    <string name="onboarding_widget_body_ios_legacy">Widget Taqwa menampilkan salat berikutnya dan hitung mundur yang terus berjalan, tanpa membuka aplikasi. Untuk menambahkannya, sentuh dan tahan layar utama, ketuk tanda plus di sudut atas, lalu cari Taqwa.</string>
