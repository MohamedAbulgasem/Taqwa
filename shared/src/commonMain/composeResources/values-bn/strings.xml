    <!-- Onboarding -->
    <string name="onboarding_welcome_title">তাকওয়া</string>
    <string name="onboarding_welcome_body">নামাজের সময়, কিবলা ও কুরআন। চিরকাল বিনামূল্যে। বিজ্ঞাপন নেই, অ্যাকাউন্ট নেই, ইন্টারনেট ছাড়াই চলে।</string>
    <string name="onboarding_welcome_cta">শুরু করুন</string>
    <string name="onboarding_location_title">আপনি কোথায় আছেন?</string>
    <string name="onboarding_location_body">নামাজের সময় আপনার অবস্থানের উপর নির্ভর করে। সব হিসাব আপনার ডিভাইসেই হয়, আর আপনার অবস্থান কখনো ফোন ছেড়ে যায় না।</string>
    <string name="onboarding_location_cta">আমার অবস্থান ব্যবহার করুন</string>
    <string name="onboarding_location_secondary">বরং একটি শহর বেছে নিন</string>
    <string name="onboarding_notifications_title">কোনো নামাজ যেন বাদ না যায়</string>
    <string name="onboarding_notifications_body">প্রতি ওয়াক্তে একটি নোটিফিকেশন। প্রতিটি নামাজের শব্দ আলাদা করে বেছে নিতে পারেন, আর যখন খুশি বদলাতেও পারেন।</string>
    <string name="onboarding_notifications_cta">নোটিফিকেশন চালু করুন</string>
    <string name="onboarding_notifications_secondary">এখন নয়</string>
    <string name="onboarding_exact_title">ঠিক সময়ে, মিনিট ধরে</string>
    <string name="onboarding_exact_body">তাকওয়াকে “অ্যালার্ম ও রিমাইন্ডার” অনুমতি দিলে তবেই অ্যান্ড্রয়েড ঠিক ওয়াক্তে বাজে। এটি ছাড়া নোটিফিকেশন এক ঘণ্টা পর্যন্ত দেরিতে আসতে পারে।</string>
    <string name="onboarding_widget_title">আপনার হোম স্ক্রিনে</string>
    <string name="onboarding_widget_body">তাকওয়া উইজেট অ্যাপ না খুলেই পরবর্তী নামাজ ও চলমান কাউন্টডাউন দেখায়।</string>
    <string name="onboarding_widget_body_ios">তাকওয়া উইজেট অ্যাপ না খুলেই পরবর্তী নামাজ ও চলমান কাউন্টডাউন দেখায়। যোগ করতে হোম স্ক্রিনে তাকওয়া আইকনটি চেপে ধরে রাখুন এবং উইজেটের আকার বেছে নিন।</string>
    <string name="onboarding_widget_body_ios_legacy">তাকওয়া উইজেট অ্যাপ না খুলেই পরবর্তী নামাজ ও চলমান কাউন্টডাউন দেখায়। যোগ করতে হোম স্ক্রিন চেপে ধরে রাখুন, উপরের কোণের প্লাস চিহ্নে চাপ দিন, তারপর তাকওয়া খুঁজুন।</string>
