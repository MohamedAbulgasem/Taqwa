  "lateLimits": {
    "entry default.safe.europe: 10 min": {
      "reason": "Paris's floors (Dhuhr + 5, Maghrib + 4) and the 1986 ones (sunrise − 2, Asr + 2) with the safety cushion on top, against calendars printing smaller minutes: sunrise up to 6 min before, Dhuhr up to 9 min after, Maghrib up to 8, Asr up to 6 (engine wave W5, safe-default-europe.tsv).",
      "events": ["sunrise", "dhuhr", "asrStandard", "maghrib"]
    },
    "entry default.safe.europe: 57 min": {
      "reason": "This region's Fajr is the latest dawn convention in wide European use (12°): 7 to 37 min after the 15° to 18° dawns Paris's, Lyon's, Marseille's and Munich's calendars print, and up to 56 min after Munich's Diyanet calendar in summer, whose seasonal takdir holds its dawn early (engine wave W5, safe-default-europe.tsv).",
      "events": ["fajr"]
    },
    "entry default.safe.europe: 135 min": {
      "reason": "The fast begins 2 min before the 18° dawn, the earliest convention in use: 12 to 60 min before the 12° to 15° Fajr the French and German calendars print, and up to 2 h 14 min before it in summer north of about 45°, where the 18° dawn comes soon after midnight or, when the sun no longer reaches it, is set by the 1986 proportion (engine wave W5, safe-default-europe.tsv).",
      "events": ["endOfEating"]
    },
    "entry default.safe.europe: 145 min": {
      "reason": "This region's Isha is the latest convention in use (18° + 2 min): 13 to 60 min after the 12° to 17° Isha the French and German calendars print, and up to 2 h 24 min after it in summer north of about 45°, where the 18° dusk comes near midnight or, when the sun no longer reaches it, is set by the 1986 proportion (engine wave W5, safe-default-europe.tsv).",
      "events": ["isha"]
    }
  }
