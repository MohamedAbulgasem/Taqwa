    "entry ie.cautious: 2 min": {
      "reason": "Each member keeps its own margins (IFI's times at its table's minute, the ICCI's rounding): starts up to 2 min after the later table's, sunrise up to 2 before the earlier's.",
      "events": ["fajr", "sunrise", "asrStandard"]
    },
    "entry ie.cautious: 3 min (endOfEating)": {
      "reason": "The end of eating is the earlier member's: the ICCI's own rule read as an end (ruling R80), but for most of June, when IFI's own dawn is the earlier; the ICCI's, taken by month and day over the leap cycle, runs up to 3 min before the earlier of the two tables' Fajr in July and August.",
      "events": ["endOfEating"]
    },
    "entry ie.cautious: 3 min (maghrib)": {
      "reason": "Each member keeps its own margins, and Maghrib is capped at IFI's where the two spread: up to 2 min after the later table's at the tables' point, and at the app's own Dublin, 2 km south-east of it, where the tables' point rides beside the user's (rulings R30, R44), up to 3.",
      "events": ["maghrib"]
    },
    "entry ie.cautious: 5 min": {
      "reason": "Isha is the later member's; the ICCI's rule on the curve's slots (ruling R28) runs up to 5 min after its table in May.",
