  "lateLimits": {
    "entry default.safe.africa: 7 min": {
      "reason": "Jamiat's and Darul Ihsan's floors (Dhuhr + 5, Maghrib + 3) with the safety cushion on top: sunrise up to 6 min before the printed one, Dhuhr and Maghrib up to 5 min after it, Asr up to 4 (engine wave W5, safe-default-africa.tsv).",
      "events": ["sunrise", "dhuhr", "asrStandard", "asrHanafi", "maghrib"]
    },
    "entry default.safe.africa: 11 min": {
      "reason": "The fast begins 2 min before the 19.5° dawn, the earliest convention on the continent: 4 to 9 min before Jamiat's printed sehri, and up to 10 min before Darul Ihsan's Fajr at Dar es Salaam and Zanzibar, whose tables print no sehri (engine wave W5, safe-default-africa.tsv).",
      "events": ["endOfEating"]
    },
    "entry default.safe.africa: 19 min": {
      "reason": "This region's Isha is the latest convention in use (18° + 2 min); Darul Ihsan prints a Shafi'i Isha at 15° beside it, 14 to 18 min earlier at Dar es Salaam and Zanzibar, and its Hanafi 18° up to 5 min earlier (engine wave W5, safe-default-africa.tsv).",
      "events": ["isha"]
    },
    "entry default.safe.africa: 25 min": {
      "reason": "This region's Fajr is the latest dawn convention in use in Africa (15°); Darul Ihsan's tables for Dar es Salaam and Zanzibar and Jamiat's for South Africa print an 18° dawn, 15 to 24 min before it (engine wave W5, safe-default-africa.tsv).",
      "events": ["fajr"]
    }
