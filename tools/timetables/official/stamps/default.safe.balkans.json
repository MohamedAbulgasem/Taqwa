  "lateLimits": {
    "entry default.safe.balkans: 10 min": {
      "reason": "Diyanet's temkin (sunrise − 7, Dhuhr + 5, Asr + 4) and Montenegro's Maghrib + 9 as floors, with the safety cushion on top, against tables printing smaller minutes: Dhuhr up to 9 min after the printed one, Maghrib up to 8, Asr up to 7, sunrise up to 6 before (engine wave W5, safe-default-balkans.tsv).",
      "events": ["sunrise", "dhuhr", "asrStandard", "maghrib"]
    },
    "entry default.safe.balkans: 17 min": {
      "reason": "The fast begins 2 min before the 19° dawn; Bosnia's and Albania's tables begin it at a shallower dawn, 7 to 16 min later (engine wave W5, safe-default-balkans.tsv).",
      "events": ["endOfEating"]
    },
    "entry default.safe.balkans: 27 min": {
      "reason": "This region's Fajr is Kosovo's Sabah, the latest in the Balkans (the 19° dawn + 20 min): 10 to 26 min after the dawn Bosnia's, Albania's and Montenegro's tables print, and up to 7 min after BIK's own Sabah at its base point (engine wave W5, safe-default-balkans.tsv).",
      "events": ["fajr"]
    },
    "entry default.safe.balkans: 34 min": {
      "reason": "This region's Isha is the latest convention in the Balkans (18.5° + 2 min): 6 to 33 min after the 17° to 18° Isha Bosnia, Albania, Kosovo and Montenegro print, most in summer (engine wave W5, safe-default-balkans.tsv).",
      "events": ["isha"]
    }
  }
