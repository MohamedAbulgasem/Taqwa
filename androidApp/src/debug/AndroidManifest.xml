<?xml version="1.0" encoding="utf-8"?>
<!-- Debug variant only. `src/debug`, not `src/androidDebug`: the KMP plugin points the Kotlin
     of this variant at `src/androidDebug/kotlin` (where the receiver is) but AGP 9 reads the
     build-type manifest overlay from `src/debug` regardless of what
     `android.sourceSets.debug.manifest` reports. The recitation harness (slice 3a task 3) is how the player is driven on
     a device before task 4 gives it a UI; `exported` is what lets `adb shell am broadcast` reach
     it, and neither the receiver nor this file is in a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="world.taqwa.app.debug.RecitationHarnessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="world.taqwa.app.debug.RECITATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
