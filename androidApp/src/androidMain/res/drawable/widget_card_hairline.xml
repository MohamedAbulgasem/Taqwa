<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded-rect outline used as the widget card's 1dp hairline border (mockup: "5 · Widgets",
  .wg { border:1px solid #232825 }). Drawn as a transparent-fill / white-stroke shape and tinted
  at render time via ColorFilter.tint(...) with a palette-derived colour, since Glance 1.1.1 has
  no border/stroke modifier of its own.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="19dp" />
    <stroke android:width="1dp" android:color="#FFFFFFFF" />
</shape>
