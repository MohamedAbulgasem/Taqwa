<?xml version="1.0" encoding="utf-8"?>
<!-- Defaults to 4x2 (4 cells = 250dp wide, 2 cells = 110dp tall). Same widget as the small one
     underneath; only the default cell differs, so it can be squeezed down to a strip or a single
     cell just the same. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewImage="@drawable/widget_preview_medium"
    android:description="@string/widget_medium_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
