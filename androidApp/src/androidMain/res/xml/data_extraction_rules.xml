<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ consults these rather than allowBackup, and they say the same thing: nothing of
  Taqwa's is copied to Google's backup or to a new phone. The reason is in the manifest, beside
  allowBackup: the settings file holds the reader's location, and "your location never leaves your
  phone" has to include the backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
