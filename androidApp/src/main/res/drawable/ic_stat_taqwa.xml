<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon: the app icon's own mihrab arch, so a Taqwa notification is recognisable as
     one at a glance. Android masks a small icon to its alpha channel, so the shape is drawn opaque
     white on transparent rather than tinted; the same silhouette as ic_launcher_monochrome, but
     scaled wider (0.9 against the launcher's 0.78, which leaves room for the launcher's own mask)
     and stroked far heavier — at 24 dp the launcher's 88-unit stroke thins to a hairline the
     status bar would drop. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="1024" android:viewportHeight="1024">
    <group android:scaleX="0.9" android:scaleY="0.9" android:pivotX="512" android:pivotY="512">
        <path
            android:pathData="M 292 780 L 292 520 C 292 372 380 268 512 216 C 644 268 732 372 732 520 L 732 780"
            android:strokeColor="#FFFFFFFF" android:strokeWidth="104"
            android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000"/>
        <path android:pathData="M 512 346 a 46 46 0 1 0 0.1 0 z" android:fillColor="#FFFFFFFF"/>
    </group>
</vector>
