# Copy to keystore.properties (git-ignored) and fill in; androidApp/build.gradle.kts reads it to
# sign release builds. Keep the keystore itself outside the repository and back it up: Play App
# Signing (on for every new app) can reset a lost upload key, but only after a support round.
storeFile=/Users/you/keys/taqwa-upload.jks
storePassword=
keyAlias=taqwa-upload
keyPassword=
